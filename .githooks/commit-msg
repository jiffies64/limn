#!/bin/sh
# Enforce "type: subject" on the first line; merges, reverts and autosquashes pass through.
first=$(head -n 1 "$1")
case "$first" in
    "Merge "* | "Revert "* | "fixup! "* | "squash! "*) exit 0 ;;
esac
echo "$first" | grep -qE '^(feat|fix|docs|refactor|test|speedup|chore)(\([a-z0-9_-]+\))?: .+' && exit 0
echo "commit message must start with 'type: subject', type one of: feat fix docs refactor test speedup chore" >&2
exit 1
